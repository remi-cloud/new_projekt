# Reference only. The public profile runs deploy/caddy-entrypoint.sh,
# which writes this same site and adds basic_auth when
# CYCLICAL_CADDY_BASIC_USER and CYCLICAL_CADDY_BASIC_HASH are both set.
{$SITE_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
	}
	reverse_proxy frontend:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
