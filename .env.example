# Cyclical Trader — przykładowa konfiguracja
# Skopiuj do .env lub ustaw w Docker / Render

CYCLICAL_SCAN_INTERVAL_MINUTES=15
CYCLICAL_DATABASE_PATH=data/trader.db

# Opcjonalne domyślne alerty (można też ustawić w UI /alerty)
CYCLICAL_ALERTS_ENABLED=false
CYCLICAL_NTFY_SERVER=https://ntfy.sh
CYCLICAL_NTFY_TOPIC=
CYCLICAL_WEBHOOK_URL=

# Parametry cyklu BTC (opcjonalne)
CYCLICAL_BTC_BEAR_PHASE_DAYS=364
CYCLICAL_BTC_BULL_PHASE_DAYS=1064
