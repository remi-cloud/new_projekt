# Cyclical Trader — przykładowa konfiguracja
# Skopiuj do .env lub ustaw w Docker / Render

CYCLICAL_SCAN_INTERVAL_MINUTES=15
CYCLICAL_DATABASE_PATH=data/trader.db

# Opcjonalne domyślne alerty (można też ustawić w UI /alerty)
CYCLICAL_ALERTS_ENABLED=false
CYCLICAL_NTFY_SERVER=https://ntfy.sh
CYCLICAL_NTFY_TOPIC=
CYCLICAL_WEBHOOK_URL=

# Parametry modeli (opcjonalne)
CYCLICAL_ALPHA_PHASE_A_DAYS=364
CYCLICAL_ALPHA_PHASE_B_DAYS=1064

# Singular Web SDK (opcjonalnie — frontend Vite; brak kluczy = wyłączone)
# VITE_SINGULAR_SDK_KEY=
# VITE_SINGULAR_SDK_SECRET=
# VITE_SINGULAR_PRODUCT_ID=
# VITE_SINGULAR_PRODUCT_NAME=Cyclical Trader
# VITE_SINGULAR_PERSIST_DOMAIN=
