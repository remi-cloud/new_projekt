# Cyclical Trader — przykładowa konfiguracja powiadomień
# Skopiuj do .env lub ustaw w Render/Docker

# SQLite — alerty i okazje
# CYCLICAL_DATABASE_PATH=/absolute/path/trader.db

# Paper trading — folder baza_portfela/ (portfolio.db + portfolio_snapshot.json)
# CYCLICAL_PORTFOLIO_DATABASE_PATH=/absolute/path/baza_portfela/portfolio.db

CYCLICAL_PRICE_POLL_INTERVAL_SECONDS=30
CYCLICAL_SCAN_INTERVAL_MINUTES=5

# Web Push (VAPID) — wygeneruj: npx web-push generate-vapid-keys
CYCLICAL_VAPID_PUBLIC_KEY=
CYCLICAL_VAPID_PRIVATE_KEY=
CYCLICAL_VAPID_SUBJECT=mailto:twoj@email.com

# SMS (Twilio)
CYCLICAL_TWILIO_ACCOUNT_SID=
CYCLICAL_TWILIO_AUTH_TOKEN=
CYCLICAL_TWILIO_FROM_NUMBER=+15005550006
CYCLICAL_ALERT_PHONE_NUMBER=+48123456789

# Progi alertów
CYCLICAL_ALERT_MIN_CONFIDENCE=60
CYCLICAL_ALERT_COOLDOWN_MINUTES=30

# AI Finance Agent (OpenAI-compatible)
# provider: auto | openai | llm7 | ollama
# auto = OpenAI when CYCLICAL_OPENAI_API_KEY set, else free LLM7 (no key)
CYCLICAL_AI_ENABLED=true
CYCLICAL_AI_PROVIDER=auto
CYCLICAL_OPENAI_API_KEY=

# Free keyless gateway (default when no OpenAI key)
CYCLICAL_FREE_LLM_BASE_URL=https://api.llm7.io/v1
CYCLICAL_FREE_LLM_MODEL=codestral-latest
CYCLICAL_FREE_LLM_FALLBACK_MODELS=meta-Llama-3.1-8B-Instruct-Turbo,minimax-m2.7

# Optional local Ollama (no key): brew install ollama && ollama serve && ollama pull llama3.2
# CYCLICAL_AI_PROVIDER=ollama
CYCLICAL_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CYCLICAL_OLLAMA_MODEL=llama3.2

# Pearl hunters (global opportunities outside core list)
CYCLICAL_PEARL_HUNTER_ENABLED=true
CYCLICAL_PEARL_EQUITY_INTERVAL_MINUTES=20
CYCLICAL_PEARL_CRYPTO_INTERVAL_MINUTES=15
CYCLICAL_PEARL_MIN_SCORE=55
CYCLICAL_OPENAI_MODEL=gpt-4o-mini
CYCLICAL_OPENAI_BASE_URL=https://api.openai.com/v1
CYCLICAL_AI_SELF_CRITIQUE_ENABLED=true
CYCLICAL_AI_SELF_LEARN_ENABLED=true
CYCLICAL_AI_SELF_LEARN_INTERVAL_MINUTES=15
CYCLICAL_AI_SELF_LEARN_MAX_LESSONS=5
CYCLICAL_AI_SELF_LEARN_ON_NEWS_REFRESH=true
CYCLICAL_AI_LEARNING_INJECT_LIMIT=8
CYCLICAL_AI_LEARN_FROM_NEWS_CHAT=true

# News hero images (agent — DALL-E when API key set, else branded Pillow cards)
CYCLICAL_NEWS_IMAGES_ENABLED=true
CYCLICAL_NEWS_IMAGES_USE_DALLE=true
CYCLICAL_NEWS_IMAGES_MAX_PER_REFRESH=8
CYCLICAL_NEWS_FRESH_HOURS=12
CYCLICAL_NEWS_DISPLAY_MAX_HOURS=6
CYCLICAL_NEWS_POLL_INTERVAL_SECONDS=120
CYCLICAL_NEWS_REFRESH_INTERVAL_SECONDS=120
CYCLICAL_OPENAI_IMAGE_MODEL=dall-e-3
CYCLICAL_OPENAI_IMAGE_SIZE=1792x1024
CYCLICAL_PEXELS_API_KEY=

# Auto-save postępu do backups/progress/ (co 20 s) + opcjonalne auto-odświeżanie UI
CYCLICAL_AUTO_BACKUP_ENABLED=true
CYCLICAL_AUTO_BACKUP_INTERVAL_SECONDS=20
CYCLICAL_AUTO_BACKUP_ROTATE_EVERY=15
CYCLICAL_AUTO_BACKUP_KEEP=2
CYCLICAL_UI_AUTO_REFRESH_SECONDS=20

# Broker execution agent (dry-run by default — no real orders)
CYCLICAL_EXECUTION_ENABLED=false
CYCLICAL_EXECUTION_DRY_RUN=true
CYCLICAL_EXECUTION_MIRROR_PAPER=false
CYCLICAL_EXECUTION_REQUIRE_APPROVAL=true

# Safety defaults for portfolio persistence
CYCLICAL_PORTFOLIO_RESTORE_BACKUP=false
CYCLICAL_PORTFOLIO_MIGRATE_LEGACY=false
CYCLICAL_EXECUTION_MIN_CONFIDENCE=70
CYCLICAL_EXECUTION_AMOUNT_PLN=10000
CYCLICAL_EXECUTION_MAX_DAILY=5
CYCLICAL_EXECUTION_COOLDOWN_HOURS=24
CYCLICAL_EXECUTION_TICK_MINUTES=10
CYCLICAL_EXECUTION_BROKER_CRYPTO=kraken
CYCLICAL_EXECUTION_BROKER_EQUITY=ibkr
CYCLICAL_EXECUTION_BROKER_EQUITY_FALLBACK=etoro

# Broker API credentials (link later)
CYCLICAL_IBKR_GATEWAY_URL=
CYCLICAL_IBKR_ACCOUNT=
CYCLICAL_ETORO_API_KEY=
CYCLICAL_KRAKEN_API_KEY=
CYCLICAL_KRAKEN_API_SECRET=
CYCLICAL_NEXO_API_KEY=
CYCLICAL_NEXO_API_SECRET=

# Social desk — news → X / LinkedIn (see docs/SOCIAL.md)
# Start dry-run: posts are composed + stored, never sent until you disable dry-run
CYCLICAL_SOCIAL_ENABLED=true
CYCLICAL_SOCIAL_DRY_RUN=true
CYCLICAL_SOCIAL_AUTO_POST=false
CYCLICAL_SOCIAL_COOLDOWN_MINUTES=60
CYCLICAL_SOCIAL_MAX_PER_CYCLE=2
# Public site URL used in post footers (Docker / production domain)
# Philippines: buy via docs/DOMAIN-PH.md then set e.g.:
# CYCLICAL_PUBLIC_BASE_URL=https://kardigital.ph
CYCLICAL_PUBLIC_BASE_URL=

# Cloudflare named tunnel (scripts/tunnel-named.sh) — never commit the token
# CLOUDFLARE_TUNNEL_TOKEN=

# X (Twitter) — OAuth 1.0a user context (Read and Write)
CYCLICAL_X_API_KEY=
CYCLICAL_X_API_SECRET=
CYCLICAL_X_ACCESS_TOKEN=
CYCLICAL_X_ACCESS_TOKEN_SECRET=

# LinkedIn — Bearer token + author URN (person or organization)
CYCLICAL_LINKEDIN_ACCESS_TOKEN=
CYCLICAL_LINKEDIN_AUTHOR_URN=

# Telegram Predator relay (FREE — see docs/TELEGRAM-PREDATOR.md)
# Create bot via @BotFather, add as admin to a channel, forward Predator signals there
CYCLICAL_TELEGRAM_PREDATOR_ENABLED=true
CYCLICAL_TELEGRAM_BOT_TOKEN=
CYCLICAL_TELEGRAM_PREDATOR_CHAT_ID=
CYCLICAL_TELEGRAM_PREDATOR_NOTIFY=true
CYCLICAL_TELEGRAM_PREDATOR_INTERVAL_SECONDS=60

# FOMO Ghost — Cope Capital (top-30 fomo.family portfolios → bag buys)
# Register: POST /api/fomo/register  OR  curl -X POST https://api.cope.capital/v1/register
# See docs/FOMO-GHOST.md
CYCLICAL_FOMO_ENABLED=true
CYCLICAL_COPE_API_KEY=
# COPE_API_KEY=   # optional alias without CYCLICAL_ prefix
CYCLICAL_FOMO_INTERVAL_SECONDS=60
CYCLICAL_FOMO_TOP_N=30
CYCLICAL_FOMO_LEADERBOARD_TIMEFRAME=7d
# FOMO Family Telegram listener (same BotFather token as Predator)
CYCLICAL_FOMO_TELEGRAM_ENABLED=true
# Comma-separated chat ids where you forward FOMO Family / bag alerts
CYCLICAL_FOMO_TELEGRAM_CHAT_IDS=

# Axiom desk — Pulse + all positions (FOMO Family bags + optional wallets)
# See docs/AXIOM.md
CYCLICAL_AXIOM_ENABLED=true
CYCLICAL_AXIOM_INTERVAL_SECONDS=90
CYCLICAL_AXIOM_TRENDING_PERIOD=1h
CYCLICAL_AXIOM_INCLUDE_CLOSED=true
# Optional: browser cookies from axiom.trade (auth-access-token / auth-refresh-token)
CYCLICAL_AXIOM_ACCESS_TOKEN=
CYCLICAL_AXIOM_REFRESH_TOKEN=
# Optional: comma-separated Solana wallets → all SPL token positions via public RPC
CYCLICAL_AXIOM_WALLETS=
# Firm wallet Kar Digital (owner_kind=kar_digital on /axiom)
CYCLICAL_KAR_DIGITAL_WALLET=

# Meme Universe · Launch Scout (flagship) — multi-DEX + Elon/CZ whispers + Binance radar
# See docs/LAUNCH-SCOUT.md
CYCLICAL_LAUNCH_SCOUT_ENABLED=true
CYCLICAL_LAUNCH_SCOUT_INTERVAL_SECONDS=60
CYCLICAL_LAUNCH_SCOUT_MAX_MC=5000000
CYCLICAL_LAUNCH_SCOUT_SEED_MC=2000
CYCLICAL_LAUNCH_SCOUT_FRESH_MC=100000
CYCLICAL_LAUNCH_SCOUT_EARLY_MC=500000
CYCLICAL_LAUNCH_SCOUT_MIN_LIQ_USD=1000
# Only post-migration DEX pairs with DexScreener paid visibility (boost/profile)
CYCLICAL_LAUNCH_SCOUT_REQUIRE_MIGRATED=true
CYCLICAL_LAUNCH_SCOUT_REQUIRE_DEX_PAID=true
CYCLICAL_LAUNCH_SCOUT_VALUE_TICKERS=memestock,cate,cash,cat,xst,calas,pepe,bonk,wif
CYCLICAL_LAUNCH_SCOUT_CHAINS=solana,base,ethereum,bsc,arbitrum,polygon,avalanche,optimism,blast,tron,sui,bitcoin,robinhood
CYCLICAL_MEME_WHISPERS_ENABLED=true
CYCLICAL_MEME_WHISPERS_X_ENABLED=true
# Optional: Solana Tracker PnL leaderboard for Pump top traders
# CYCLICAL_SOLANA_TRACKER_API_KEY=

# Coordinator (multi-agent health) + Binance AI bridge
CYCLICAL_COORDINATOR_INTERVAL_SECONDS=300
CYCLICAL_BINANCE_AI_BOT_URL=
CYCLICAL_BINANCE_AI_BOT_KEY=
CYCLICAL_BINANCE_API_KEY=
CYCLICAL_BINANCE_API_SECRET=
CYCLICAL_BINANCE_AI_BOT_ENABLED=true
CYCLICAL_BINANCE_AI_BOT_INTERVAL_SECONDS=120
CYCLICAL_BINANCE_AI_BOT_DRY_RUN=true
CYCLICAL_BINANCE_AI_BOT_MIRROR_PAPER=true
CYCLICAL_BINANCE_DRIFT_ALERT_PCT=15
