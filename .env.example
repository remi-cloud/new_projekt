# Cyclical Trader — przykładowa konfiguracja powiadomień
# Skopiuj do .env lub ustaw w Render/Docker

# SQLite — alerty i okazje
# CYCLICAL_DATABASE_PATH=/absolute/path/trader.db

# Paper trading — folder baza_portfela/ (portfolio.db + portfolio_snapshot.json)
# CYCLICAL_PORTFOLIO_DATABASE_PATH=/absolute/path/baza_portfela/portfolio.db

CYCLICAL_PRICE_POLL_INTERVAL_SECONDS=30
CYCLICAL_SCAN_INTERVAL_MINUTES=5

# Web Push (VAPID) — wygeneruj: npx web-push generate-vapid-keys
CYCLICAL_VAPID_PUBLIC_KEY=
CYCLICAL_VAPID_PRIVATE_KEY=
CYCLICAL_VAPID_SUBJECT=mailto:twoj@email.com

# SMS (Twilio)
CYCLICAL_TWILIO_ACCOUNT_SID=
CYCLICAL_TWILIO_AUTH_TOKEN=
CYCLICAL_TWILIO_FROM_NUMBER=+15005550006
CYCLICAL_ALERT_PHONE_NUMBER=+48123456789

# Progi alertów
CYCLICAL_ALERT_MIN_CONFIDENCE=60
CYCLICAL_ALERT_COOLDOWN_MINUTES=30
